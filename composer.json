{
    "name": "s-form/formvalidator",
    "description": "Secure PHP form validation framework",
    "version": "1.0",
    "type": "library",
    "license": "MIT",
    "keywords": ["validation", "form", "psr", "php"],
    "authors": [
        {
            "name": "Ibnu Yasir"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "paragonie/anti-csrf": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SFORM\\FormValidator\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SFORM\\FormValidator\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
